# Resend API — для отправки заявок с формы обратной связи
# Получить ключ: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email для получения заявок с сайта
# По умолчанию info@grandpro.kz
CONTACT_EMAIL=info@grandpro.kz

# Upstash Redis — rate limiting для формы обратной связи
# Создать базу: https://console.upstash.com → Create Database → выбрать регион fra1
# Скопировать из вкладки REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2GIS Maps & Suggest API — подсказки адресов и карта
# Получить ключ: https://dev.2gis.com (глобал) или https://platform.2gis.ru (только Россия)
NEXT_PUBLIC_2GIS_KEY=
